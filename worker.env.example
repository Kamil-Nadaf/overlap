# Reminder + confirmation emails when you use Supabase (no Docker db).
# 1. cp worker.env.example worker.env   2. fill it in   3. run the worker (see docs/DEPLOY.md)
# Supabase: Project Settings > Database > Connection string > "Session pooler" URI (replace [YOUR-PASSWORD]).
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# The public site people open (used in email links):
APP_URL=https://kamil-nadaf.github.io/overlap
MAIL_FROM=Overlap <you@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-gmail-app-password
POLL_SECONDS=60
# Optional: email new feedback from the site's Feedback button to this address (run supabase/migrations/0005_feedback.sql first):
FEEDBACK_TO=kamilnadaf@smail.nju.edu.cn
