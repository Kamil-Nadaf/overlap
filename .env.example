# Copy to .env (Docker stack) or .env.local (local `npm run dev`). Never commit real values.

# ---------------- Local dev / GitHub Pages build (optional) ----------------
# Leave all of these empty to run the app in demo mode (data stays in your browser).
# VITE_API_URL=http://localhost:8080/api         # Docker stack or any PostgREST
# VITE_SUPABASE_URL=https://YOUR-REF.supabase.co  # or Supabase (the anon key is public by design)
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com   # optional: organizers send from their own Gmail (docs/GOOGLE_OAUTH.md)


# ---------------- Docker stack (docker compose up) ----------------
POSTGRES_PASSWORD=change-me-please
WEB_PORT=8080
# Public URL people will open (used inside reminder emails):
APP_URL=http://localhost:8080
# Reminder email. Default = Mailpit (dev, see http://localhost:8025). For real email use SMTP, e.g. Gmail app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
#   MAIL_FROM=Overlap <you@gmail.com>
MAIL_FROM=Overlap <overlap@localhost>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------- Frontend on GitHub Pages ----------------
# Point the static site at any backend that speaks the same RPCs:
#   Docker stack exposed publicly:  VITE_API_URL=https://overlap.example.com/api
#   Supabase:                        VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
